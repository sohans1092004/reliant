DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=reliant

KAFKA_BROKER=localhost:9092   # comma-separated list for MSK
# KAFKA_SSL=true                # MSK (TLS listener)
# DB_SSL_CA=/etc/rds/global-bundle.pem   # RDS: TLS, server certificate verified against this CA bundle


RETRY_FAST_MODE=false
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Encrypts endpoint signing secrets at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# Shared token internal producers send to the ingest API.
INGEST_TOKEN=
INGEST_PORT=3000
DASHBOARD_PORT=3001
# Dashboard session cookie is Secure (fine on http://localhost). false only for another plain-HTTP host.
# COOKIE_SECURE=true
# Behind a load balancer: take the client IP from X-Forwarded-For for login rate limits.
# TRUST_PROXY=false
# Default per-tenant token bucket (override per tenant: tenants.rate_limit_per_sec / rate_limit_burst)
RATE_LIMIT_PER_SEC=1000
RATE_LIMIT_BURST=2000
MAX_PER_TENANT_PER_SWEEP=10

# Tracing: send OpenTelemetry spans here (Jaeger from `docker compose --profile observability`).
# Unset = tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Internal Prometheus /metrics port for this process (defaults: ingest 9100, consumer 9101,
# worker 9102, dashboard 9103, retry-publisher 9104). 0 disables it.
# METRICS_PORT=

# Dev only: `npm run migrate` also creates tenant_a / tenant_b, whose API keys are in the repo.
DEV_SEED=true

# Dev only: lets endpoints point at localhost (fake-slow-endpoint.js). Never in prod.
ALLOW_PRIVATE_ENDPOINTS=false

# AWS (optional). With KMS_KEY_ID set, endpoint secrets use KMS envelope encryption
# (`npm run migrate` re-wraps existing ones) and SECRET_ENCRYPTION_KEY is only needed to read
# rows that haven't been re-wrapped yet. With ARCHIVE_BUCKET set, retention archives go to S3.
# Locally: `docker compose --profile aws up -d` (LocalStack), then export these for one session.
# Don't leave KMS_KEY_ID in .env: LocalStack's free edition keeps no state, so after it
# restarts, secrets wrapped under its key can't be decrypted (rotate them to recover).
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# KMS_KEY_ID=alias/reliant-secrets
# ARCHIVE_BUCKET=reliant-archive
