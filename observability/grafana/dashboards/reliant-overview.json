    {
      "id": 11,
      "type": "table",
      "title": "Success rate by tenant (lowest first)",
      "description": "Last 15 minutes. Low numbers usually mean the tenant's endpoint is struggling, not Reliant.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tenant) (rate(reliant_delivery_attempts_total{outcome=\"delivered\"}[15m])) / sum by (tenant) (rate(reliant_delivery_attempts_total[15m]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Success rate",
              "tenant": "Tenant"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Success rate",
            "desc": false
          }
        ]
      }
