# Copy to deploy/.env (gitignored) and fill in. Generate each secret with:
#   openssl rand -base64 32
DOMAIN=reliant.example.com     # an A record pointing at this VM

POSTGRES_PASSWORD=
SECRET_ENCRYPTION_KEY=         # must be exactly 32 bytes, base64: openssl rand -base64 32
INGEST_TOKEN=                  # producers send this as Authorization: Bearer

# Per-tenant ingest limit (events/s, burst). Low by default for a public demo.
RATE_LIMIT_PER_SEC=50
RATE_LIMIT_BURST=100

# The demo receiver's endpoint secret(s), comma-separated during a rotation (README, step 5).
RELIANT_WEBHOOK_SECRETS=
